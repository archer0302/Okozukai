# Required for the API to start in Production. Copy this file to .env and fill in
# real values; .env itself is already ignored by git (see .gitignore's
# "Environment Secrets" block, so no .gitignore edit is needed here).
#
# If a password contains a semicolon (;) or an equals sign (=), it must be quoted
# per Npgsql's keyword-value quoting rules - the example below shows only the plain
# unquoted form; the real value is authored at deploy time.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__okozukai=Host=postgres;Port=5432;Database=okozukai;Username=okozukai;Password=changeme
